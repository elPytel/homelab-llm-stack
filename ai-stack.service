[Unit]
Description=AI Stack (Ollama + Open WebUI)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Cesta k naklonovanému repozitáři:
WorkingDirectory=%h/Git/homelab-llm-stack

# Aktualizace repozitáře před startem stacku:
ExecStartPre=/usr/bin/git pull --ff-only

# Spuštění přes Makefile:
ExecStart=/usr/bin/make up

# Bezpečné zastavení stacku při vypínání VM:
ExecStop=/usr/bin/make down

TimeoutStartSec=0

[Install]
WantedBy=default.target
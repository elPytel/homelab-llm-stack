[Unit]
Description=AI Stack (Ollama + Open WebUI)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Cesta k tvému naklonovanému repozitáři:
WorkingDirectory=%h/Git/homelab-llm-stack

# Spuštění přes Makefile (který automaticky detekuje NVIDIA GPU):
ExecStart=/usr/bin/make up

# Update the repository (pull) after each start:
PostStart=/bin/bash -c "cd %h/Git/homelab-llm-stack && git pull"

# Bezpečné zastavení stacku při vypínání VM:
ExecStop=/usr/bin/make down

TimeoutStartSec=0

[Install]
WantedBy=default.target